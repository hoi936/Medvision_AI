# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Streamlit and local tooling
.streamlit/secrets.toml
.agents/
.codex/

# Environment files, private keys and credential stores
.env
.env.*
*.pem
*.key
*.credentials.json
*-credentials.json
/.credentials/
/credentials/
/credential-store/
/credential_stores/

# Cloudflare Tunnel credentials and tokens (never commit)
/.cloudflared/
/cloudflared/credentials*.json
/cloudflared/*-credentials.json
*tunnel-token*

# Hermes local state; keep project-local skills tracked
/.hermes/config.yaml
/.hermes/.env
/.hermes/state.db*
/.hermes/sessions/
/.hermes/logs/
/.hermes/vault/

# Third-party Hermes checkout and its isolated runtime
hermes-agent/
.hermes-runtime/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
~$*

# Generated case data and reports
/uploads/
/generated_uploads/
/reports/
/generated_reports/
/AI_model/uploads/
/AI_model/generated_uploads/
/AI_model/reports/
/AI_model/generated_reports/

# Local training archives; compact inference weights are tracked in AI_model/models/
/model_artifacts/

# Provider/runtime directories managed outside source control
.vendor/
.runtime/
